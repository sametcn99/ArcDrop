{
  "name": "arcdrop",
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.5.0",
    "typescript-eslint": "^8.24.0"
  },
  "description": "ArcDrop — self-hosted, multi-user bookmark platform (monorepo)",
  "private": true,
  "scripts": {
    "dev": "bun --cwd=apps/api run dev",
    "build": "bun --cwd=apps/api run build",
    "start": "bun --cwd=apps/api run start",
    "lint": "eslint .",
    "typecheck": "bun --cwd=apps/api run typecheck",
    "test": "bun --cwd=apps/api test",
    "test:unit": "bun --cwd=apps/api test src",
    "test:e2e": "bun --cwd=apps/api test e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "web:dev": "bun --cwd=apps/web/app run dev",
    "web:build": "bun --cwd=apps/web/app run build",
    "web:lint": "bun --cwd=apps/web/app run lint",
    "web:typecheck": "bun --cwd=apps/web/app run typecheck",
    "web:test": "bun --cwd=apps/web/app run test",
    "web:generate:api": "bun --cwd=apps/web/app run generate:api",
    "extension:dev": "bun --cwd=extension run dev",
    "extension:build": "bun --cwd=extension run build",
    "extension:lint": "bun --cwd=extension run lint",
    "extension:typecheck": "bun --cwd=extension run typecheck",
    "cross-platform:dev": "bun --cwd=cross-platform run dev",
    "cross-platform:build": "bun --cwd=cross-platform run build",
    "cross-platform:build:no-bundle": "bun --cwd=cross-platform run build:no-bundle",
    "cross-platform:android:init": "bun --cwd=cross-platform run android:init",
    "cross-platform:android:dev": "bun --cwd=cross-platform run android:dev",
    "cross-platform:android:build": "bun --cwd=cross-platform run android:build",
    "cross-platform:ios:init": "bun --cwd=cross-platform run ios:init",
    "cross-platform:rust:fmt": "bun --cwd=cross-platform run rust:fmt",
    "cross-platform:rust:clippy": "bun --cwd=cross-platform run rust:clippy",
    "cross-platform:rust:test": "bun --cwd=cross-platform run rust:test"
  },
  "workspaces": [
    "apps/*",
    "apps/web/*"
  ]
}
