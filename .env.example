# Generate independent secrets with: openssl rand -hex 32
ARCDROP__JWT__SECRET=replace-me-with-output-of-openssl-rand-hex-32
ARCDROP__TOTP__ENCRYPTION_KEY=replace-me-with-a-different-random-secret

POSTGRES_USER=arcdrop
POSTGRES_PASSWORD=arcdrop
POSTGRES_DB=arcdrop

# Browser-facing address. Put a TLS proxy in front of this listener for remote use.
ARCDROP_WEB_BIND=127.0.0.1
ARCDROP_WEB_PORT=3000
ARCDROP__PUBLIC__BASE_URL=
# Set the specific trusted upstream proxy IP(s) or CIDR(s), space-separated.
# ARCDROP_WEB_TRUSTED_PROXY_CIDRS=172.30.249.1
# Override together if the private gateway subnet conflicts with another network.
# ARCDROP_GATEWAY_SUBNET=172.30.249.0/29
# ARCDROP_WEB_GATEWAY_IP=172.30.249.2

# Standalone clients on other web origins only.
ARCDROP__CORS__ORIGINS=
ARCDROP__METRICS__ENABLED=false
ARCDROP__LOG__LEVEL=info

# Optional portability controls. Increase any front proxy body limit accordingly.
# ARCDROP__PORTABILITY__IMPORT_MAX_BYTES=26214400
# ARCDROP__PORTABILITY__IMPORT_ZIP_MAX_BYTES=314572800
# ARCDROP__PORTABILITY__ZIP_EXPANDED_MAX_BYTES=1073741824
# ARCDROP__PORTABILITY__ZIP_MAX_ENTRIES=10000
# ARCDROP__PORTABILITY__ZIP_CONCURRENT_TRANSFERS=1
