# ArcDrop compose overrides — copy to .env next to compose.yaml and edit.
# docker compose loads that file automatically.

# REQUIRED in production: JWT signing secret (min 32 chars).
# The compose default is a DEV-ONLY fallback; do not ship it.
ARCDROP__JWT__SECRET=change-me-to-a-long-random-value-0123456789abcdef

# Bundled PostgreSQL credentials (change the password in production).
POSTGRES_USER=arcdrop
POSTGRES_PASSWORD=arcdrop
POSTGRES_DB=arcdrop

# Browser origins allowed to call the API (comma-separated). Empty = no CORS.
ARCDROP__CORS__ORIGINS=http://localhost:5173

# Prometheus metrics at /metrics (default off).
ARCDROP__METRICS__ENABLED=false

# Log level: fatal | error | warn | info | debug | trace
ARCDROP__LOG__LEVEL=info
