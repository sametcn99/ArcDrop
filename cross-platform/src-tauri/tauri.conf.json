{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArcDrop",
  "version": "0.1.0",
  "identifier": "com.arcdrop.app",
  "build": {
    "beforeDevCommand": "bun --cwd=../apps/web/app run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun --cwd=../apps/web/app run build",
    "frontendDist": "../../apps/web/app/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ArcDrop",
        "width": 1024,
        "height": 768,
        "minWidth": 360,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
