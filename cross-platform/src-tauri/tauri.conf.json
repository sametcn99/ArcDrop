{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArcDrop",
  "version": "0.2.1",
  "identifier": "com.arcdrop.client",
  "build": {
    "beforeDevCommand": "bun --cwd=../apps/web/app run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun --cwd=../apps/web/app run build",
    "frontendDist": "../../apps/web/app/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ArcDrop",
        "width": 1024,
        "height": 768,
        "minWidth": 360,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["arcdrop"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwMjU2NkQzNUJFMTNEMTYKUldRV1BlRmIwMllsNEl0NTM1YjJqWGtuUkRRMkRiY2VYWFVQMFlqVUVnblhYU2xzSWZwbDJONSsK",
      "endpoints": ["https://github.com/sametcn99/ArcDrop/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
