@inject NavigationManager NavigationManager

@if (Node is null)
{
    return;
}

<div class="collection-tree-node" style="margin-left:@(Depth * 0.7)rem;">
    <div class="collection-tree-node__header @(IsActive ? "is-active" : string.Empty)">
        @if (HasNestedContent)
        {
            <button class="sidebar-collapse-toggle"
                    type="button"
                    aria-label="Toggle collection content"
                    aria-expanded="@IsExpanded"
                    @onclick="ToggleExpanded">
                <span class="sidebar-collapse-icon @(IsExpanded ? "is-expanded" : string.Empty)"></span>
            </button>
        }
        else
        {
            <div class="sidebar-collapse-toggle sidebar-collapse-toggle--placeholder"></div>
        }

        <a class="collection-tree-node__header-link"
           href="@ResolvedHref">
            <span class="collection-tree-node__name">@Node.Name</span>
            <span class="collection-tree-node__count">@Node.Bookmarks.Count</span>
        </a>

        @if (Actions is not null && !IsVirtualNode)
        {
            <span class="collection-tree-node__actions">
                <button type="button"
                        class="collection-tree-node__action"
                        aria-label="Edit collection @Node.Name"
                        @onclick="(() => Actions.RequestEdit(Node))">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </button>
                <button type="button"
                        class="collection-tree-node__action collection-tree-node__action--danger"
                        aria-label="Delete collection @Node.Name"
                        @onclick="(() => Actions.RequestDelete(Node))">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                </button>
            </span>
        }
    </div>

    @if (IsExpanded && Node.Bookmarks.Count > 0)
    {
        <div class="collection-tree-node__bookmarks">
            @foreach (var bookmark in Node.Bookmarks)
            {
                <a class="bookmark-link" href="@bookmark.Url" target="_blank" rel="noopener noreferrer">
                    <span class="bookmark-link__title">@bookmark.Title</span>
                    <span class="bookmark-link__meta">@UrlUtilities.DomainFromUrl(bookmark.Url)</span>
                </a>
            }
        </div>
    }

    @if (IsExpanded && Node.Children.Count > 0)
    {
        <div class="collection-tree-node__children">
            @foreach (var child in Node.Children)
            {
                <CollectionTreeNode Node="child" Depth="@(Depth + 1)" ActiveCollectionId="ActiveCollectionId" />
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public CollectionTreeNodeDto Node { get; set; } = null!;

    [Parameter]
    public int Depth { get; set; }

    [Parameter]
    public Guid? ActiveCollectionId { get; set; }

    [Parameter]
    public string? HrefOverride { get; set; }

    [Parameter]
    public bool ForceActive { get; set; }

    /// <summary>
    /// Virtual nodes (such as the "Other" bucket) have no persisted identity and hide edit/delete actions.
    /// </summary>
    [Parameter]
    public bool IsVirtualNode { get; set; }

    [CascadingParameter]
    private CollectionNodeActions? Actions { get; set; }

    private bool IsActive => ForceActive || (ActiveCollectionId.HasValue && ActiveCollectionId.Value == Node.Id);
    private bool IsExpanded { get; set; } = true;
    private bool HasNestedContent => Node.Bookmarks.Count > 0 || Node.Children.Count > 0;
    private string ResolvedHref => string.IsNullOrWhiteSpace(HrefOverride)
        ? $"/bookmarks?collectionId={Node.Id}"
        : HrefOverride;

    private void ToggleExpanded()
    {
        IsExpanded = !IsExpanded;
    }
}
