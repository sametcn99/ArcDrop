@using ArcDrop.Web.Components.UI

@inject IArcDropApiClient ApiClient
@inject ISharedStateService SharedStateService

@if (IsOpen && Collection is not null)
{
    <div class="arc-modal-backdrop" @onclick="CloseAsync"></div>
    <section class="arc-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="edit-collection-title"
             tabindex="-1"
             @ref="_dialogFocus"
             @onkeydown="HandleKeyDownAsync">
        <header class="arc-modal__header">
            <div>
                <h2 id="edit-collection-title">Edit Collection</h2>
                <p class="page-subtitle">Rename, describe, or move this collection in the hierarchy.</p>
            </div>
            <button class="arc-modal__close" type="button" @onclick="CloseAsync" aria-label="Close edit dialog" disabled="@IsSaving">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </header>

        <EditForm Model="EditModel" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label" for="edit-collection-name">Name</label>
                <InputText id="edit-collection-name" class="form-control" @bind-Value="EditModel.Name" placeholder="Collection name" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="edit-collection-description">Description</label>
                <InputTextArea id="edit-collection-description" class="form-control" @bind-Value="EditModel.Description" rows="2" placeholder="Optional description" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="edit-collection-parent">Parent Collection</label>
                <InputSelect id="edit-collection-parent" class="form-select" @bind-Value="EditModel.ParentId">
                    <option value="">Root</option>
                    @foreach (var candidate in SelectableParents)
                    {
                        <option value="@candidate.Id">@candidate.Name</option>
                    }
                </InputSelect>
                <div class="form-text">A collection cannot become its own descendant.</div>
            </div>

            @if (!string.IsNullOrWhiteSpace(ErrorText))
            {
                <div class="alert alert-danger" role="alert">@ErrorText</div>
            }

            <footer class="arc-modal__footer">
                <button class="btn btn-outline-secondary" type="button" @onclick="CloseAsync" disabled="@IsSaving">Cancel</button>
                <button class="btn btn-primary" type="submit" disabled="@IsSaving">
                    @if (IsSaving) { <span class="spinner-inline"></span> }
                    Save Changes
                </button>
            </footer>
        </EditForm>
    </section>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public CollectionDto? Collection { get; set; }

    [Parameter]
    public IReadOnlyList<CollectionDto> AvailableCollections { get; set; } = [];

    [Parameter]
    public EventCallback OnCloseRequested { get; set; }

    [Parameter]
    public EventCallback OnUpdated { get; set; }

    private UpdateCollectionRequest EditModel { get; set; } = new();
    private bool IsSaving { get; set; }
    private string? ErrorText { get; set; }
    private ElementReference _dialogFocus;
    private bool _wasOpen;

    /// <summary>
    /// Parent candidates exclude the edited collection and its descendants so cycles stay impossible in the UI.
    /// </summary>
    private IEnumerable<CollectionDto> SelectableParents
    {
        get
        {
            if (Collection is null)
            {
                return AvailableCollections;
            }

            var descendants = CollectDescendantIds(Collection.Id).ToHashSet();
            return AvailableCollections.Where(candidate => !descendants.Contains(candidate.Id));
        }
    }

    protected override void OnParametersSet()
    {
        if (IsOpen && !_wasOpen && Collection is not null)
        {
            EditModel = new UpdateCollectionRequest
            {
                Name = Collection.Name,
                Description = Collection.Description,
                ParentId = Collection.ParentId
            };
            ErrorText = null;
        }

        _wasOpen = IsOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen && !_wasOpen)
        {
            try
            {
                await _dialogFocus.FocusAsync();
            }
            catch (ObjectDisposedException)
            {
                // The dialog can close before focus completes during rapid interactions.
            }
        }
    }

    private IEnumerable<Guid> CollectDescendantIds(Guid rootId)
    {
        var childrenByParent = AvailableCollections.ToLookup(collection => collection.ParentId);
        var queue = new Queue<Guid>();
        queue.Enqueue(rootId);

        while (queue.Count > 0)
        {
            var current = queue.Dequeue();
            yield return current;

            foreach (var child in childrenByParent[current])
            {
                queue.Enqueue(child.Id);
            }
        }
    }

    private async Task CloseAsync()
    {
        if (IsSaving)
        {
            return;
        }

        await OnCloseRequested.InvokeAsync();
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.Ordinal))
        {
            await CloseAsync();
        }
    }

    private async Task SaveAsync()
    {
        if (Collection is null)
        {
            return;
        }

        IsSaving = true;
        ErrorText = null;

        try
        {
            await ApiClient.UpdateCollectionAsync(Collection.Id, EditModel, CancellationToken.None);
            SharedStateService.NotifyCollectionsUpdated();
            await OnUpdated.InvokeAsync();
            await OnCloseRequested.InvokeAsync();
        }
        catch (ApiClientException exception)
        {
            ErrorText = exception.UserMessage;
        }
        catch (Exception)
        {
            ErrorText = "Collection update failed.";
        }
        finally
        {
            IsSaving = false;
        }
    }
}
