@inject IArcDropApiClient ApiClient

<div class="tag-input-shell">
    <div class="tag-input-row">
        <input type="text"
               class="form-control"
               id="@InputId"
               value="@_draft"
               list="@SuggestionListId"
               placeholder="Type a tag, then press Add (commas split)"
               aria-label="Bookmark tags"
               @oninput="HandleInput"
               @onblur="CommitDraftAsync" />
        <button type="button" class="btn btn-outline-secondary" @onclick="CommitDraftAsync">Add</button>
    </div>
    <datalist id="@SuggestionListId">
        @foreach (var suggestion in _knownTags)
        {
            <option value="@suggestion" />
        }
    </datalist>

    @if (Tags.Count > 0)
    {
        <div class="tag-chip-list" role="list" aria-label="Assigned tags">
            @foreach (var tag in Tags)
            {
                <span class="tag-chip" role="listitem">
                    @tag
                    <button type="button"
                            class="tag-chip__remove"
                            aria-label="Remove tag @tag"
                            @onclick="(() => RemoveTag(tag))">
                        &times;
                    </button>
                </span>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public IReadOnlyList<string> Tags { get; set; } = [];

    [Parameter]
    public EventCallback<IReadOnlyList<string>> TagsChanged { get; set; }

    [Parameter]
    public string? InputId { get; set; }

    private string SuggestionListId => $"{(string.IsNullOrWhiteSpace(InputId) ? "tag-input" : InputId)}-suggestions";

    private readonly List<string> _knownTags = [];
    private string _draft = string.Empty;
    private bool _tagsLoaded;

    protected override async Task OnParametersSetAsync()
    {
        // Known tags power the datalist suggestions; they load lazily on first render.
        if (!_tagsLoaded)
        {
            try
            {
                var tags = await ApiClient.GetTagsAsync(CancellationToken.None);
                _knownTags.AddRange(tags.Select(tag => tag.Name));
                _tagsLoaded = true;
            }
            catch (ApiClientException)
            {
                // Suggestions are optional; failed loads leave the plain text entry working.
                _tagsLoaded = true;
            }
        }
    }

    private void HandleInput(ChangeEventArgs args)
    {
        _draft = args.Value?.ToString() ?? string.Empty;

        // Typing a comma commits the fragment so users can chain tags without leaving the field.
        if (_draft.Contains(','))
        {
            foreach (var fragment in _draft.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            {
                AddTag(fragment);
            }

            _draft = string.Empty;
        }
    }

    private Task CommitDraftAsync()
    {
        AddTag(_draft);
        _draft = string.Empty;
        return Task.CompletedTask;
    }

    private void AddTag(string? rawTag)
    {
        var tag = rawTag?.Trim();
        if (string.IsNullOrWhiteSpace(tag))
        {
            return;
        }

        if (Tags.Any(existing => string.Equals(existing, tag, StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }

        var updated = Tags.Append(tag).OrderBy(static item => item, StringComparer.OrdinalIgnoreCase).ToList();
        _ = TagsChanged.InvokeAsync(updated);
    }

    private void RemoveTag(string tag)
    {
        var updated = Tags.Where(existing => !string.Equals(existing, tag, StringComparison.OrdinalIgnoreCase)).ToList();
        _ = TagsChanged.InvokeAsync(updated);
    }
}
