@inject IArcDropApiClient ApiClient
@inject NavigationManager NavigationManager

<div class="card-shell">
    <div class="section-header">
        <h2>Rotate Admin Password</h2>
    </div>
    <p class="page-subtitle">Passwords must be at least 12 characters. Reuse of a recent password is rejected.</p>

    <EditForm Model="Model" OnValidSubmit="RotateAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label" for="rotation-current">Current Password</label>
            <InputText id="rotation-current" class="form-control" type="password" @bind-Value="Model.CurrentPassword" autocomplete="current-password" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="rotation-new">New Password</label>
            <InputText id="rotation-new" class="form-control" type="password" @bind-Value="Model.NewPassword" autocomplete="new-password" />
        </div>

        @if (!string.IsNullOrWhiteSpace(ErrorText))
        {
            <div class="alert alert-danger" role="alert">@ErrorText</div>
        }

        <button class="btn btn-primary" type="submit" disabled="@IsBusy">
            @if (IsBusy) { <span class="spinner-inline"></span> }
            Rotate Password
        </button>
    </EditForm>

    @if (!string.IsNullOrWhiteSpace(StatusText) && string.IsNullOrWhiteSpace(ErrorText))
    {
        <p class="status-hint mt-3" role="status">@StatusText</p>
    }
</div>

@code {
    private RotateAdminPasswordRequest Model { get; set; } = new();
    private bool IsBusy { get; set; }
    private string? ErrorText { get; set; }
    private string? StatusText { get; set; }

    private async Task RotateAsync()
    {
        IsBusy = true;
        ErrorText = null;
        StatusText = null;

        try
        {
            await ApiClient.RotatePasswordAsync(Model, CancellationToken.None);
            Model = new RotateAdminPasswordRequest();
            StatusText = "Password rotated successfully.";
        }
        catch (ApiClientException exception) when (SessionRedirect.ShouldRedirect(exception))
        {
            SessionRedirect.RedirectToLogin(NavigationManager);
        }
        catch (ApiClientException exception)
        {
            ErrorText = exception.UserMessage;
        }
        catch (Exception)
        {
            ErrorText = "Password rotation failed. Check current password and policy constraints.";
        }
        finally
        {
            IsBusy = false;
        }
    }
}
