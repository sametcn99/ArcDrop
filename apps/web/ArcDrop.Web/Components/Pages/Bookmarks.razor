@page "/"
@page "/bookmarks"

@using ArcDrop.Web.Components.UI

@inject IArcDropApiClient ApiClient
@inject ISharedStateService SharedStateService
@inject NavigationManager NavigationManager
@inject IUrlMetadataLookup MetadataLookup
@implements IDisposable

<PageTitle>Bookmarks</PageTitle>

<div class="raindrop-header">
    <div>
        <h1>Bookmarks</h1>
        <p class="page-subtitle">Your reading queue and bookmark workspace.</p>
    </div>
</div>

<div class="raindrop-board">
    <aside class="raindrop-sidebar card-shell">
        <h2 id="collections-heading">Collections</h2>
        <button class="collection-item @(SelectedCollectionId is null && !IsOtherCollectionSelected ? "is-active" : string.Empty)" @onclick="(() => SelectCollection(null))">
            <span>All bookmarks</span>
            <strong>@_stats.TotalCount</strong>
        </button>

        <button class="collection-item @(IsOtherCollectionSelected ? "is-active" : string.Empty)" @onclick="SelectOtherCollection">
            <span>Other</span>
            <strong>@_stats.UnassignedCount</strong>
        </button>

        @foreach (var collection in AvailableCollections.OrderBy(collection => UrlUtilities.CollectionDepth(AvailableCollections, collection.Id)).ThenBy(collection => collection.Name))
        {
            var collectionBookmarkCount = CountBookmarksInCollection(collection.Id);
            <button class="collection-item @(SelectedCollectionId == collection.Id ? "is-active" : string.Empty)"
                    style="margin-left:@(UrlUtilities.CollectionDepth(AvailableCollections, collection.Id) * 0.7)rem;"
                    @onclick="(() => SelectCollection(collection.Id))">
                <span>@collection.Name</span>
                <strong>@collectionBookmarkCount</strong>
            </button>
        }
    </aside>

    <section aria-label="Bookmark results">
        <div class="card-shell mb-3 raindrop-toolbar">
            <label class="visually-hidden" for="bookmark-search">Search bookmarks</label>
            <input id="bookmark-search"
                   class="form-control"
                   type="search"
                   placeholder="Search title, URL, summary, or tag"
                   aria-label="Search bookmarks"
                   @bind="SearchText"
                   @bind:event="oninput" />

            <label class="visually-hidden" for="bookmark-sort">Sort bookmarks</label>
            <select id="bookmark-sort" class="form-select" value="@Sort" @onchange="HandleSortChangedAsync" aria-label="Sort bookmarks">
                <option value="updated">Recently updated</option>
                <option value="created">Newest</option>
                <option value="title">Title A-Z</option>
            </select>

            <button class="btn btn-primary" type="button" @onclick="OpenCreateDialog">Add Bookmark</button>
            <button class="btn btn-outline-secondary" type="button" @onclick="OpenCreateCollectionDialog">New Collection</button>
            <button class="btn btn-outline-secondary" @onclick="(() => LoadAsync())" disabled="@IsLoading">Refresh</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(SelectedTag))
        {
            <div class="card-shell mb-3 tag-filter-bar">
                <span class="tag-chip tag-chip--filter">
                    @SelectedTag
                    <button type="button" class="tag-chip__remove" aria-label="Clear tag filter" @onclick="ClearTagFilter">&times;</button>
                </span>
                <span class="form-text">Filtered by tag.</span>
            </div>
        }

        @if (IsLoading)
        {
            <div class="card-shell" style="padding: 2rem; text-align: center;">
                <span class="spinner-inline"></span> Loading bookmarks...
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(ErrorText))
        {
            <div class="alert alert-danger" role="alert">@ErrorText</div>
        }
        else if (_pageItems.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state__icon">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
                </div>
                <p class="empty-state__title">No bookmarks found</p>
                <p class="empty-state__text">Try a different search or filter, or add your first bookmark.</p>
            </div>
        }
        else
        {
            <p class="form-text" aria-live="polite">@_totalCount bookmark(s) found. Page @_page of @TotalPages.</p>
            <div class="bookmark-feed">
                @foreach (var item in _pageItems)
                {
                    <article class="bookmark-card">
                        <div class="bookmark-card__heading">
                            <div class="bookmark-card__icon-shell" aria-hidden="true">
                                <img class="bookmark-card__icon"
                                     src="@UrlUtilities.BuildBookmarkIconUrl(item.Url)"
                                     alt=""
                                     width="44"
                                     height="44"
                                     onload="this.nextElementSibling.style.display='none'; this.style.display='block';"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-flex';" />
                                <span class="bookmark-card__icon-fallback">@UrlUtilities.DomainInitial(item.Url)</span>
                            </div>
                            <div class="bookmark-card__heading-copy">
                                <div class="bookmark-card__meta">
                                    <span>@item.UpdatedAtUtc.ToLocalTime().ToString("g")</span>
                                    <span class="bookmark-card__domain">@UrlUtilities.DomainFromUrl(item.Url)</span>
                                </div>
                                <h3>@item.Title</h3>
                            </div>
                        </div>
                        <a href="@item.Url" target="_blank" rel="noopener noreferrer">@item.Url</a>
                        @if (!string.IsNullOrWhiteSpace(item.Summary))
                        {
                            <p>@item.Summary</p>
                        }
                        @if (item.Tags is { Count: > 0 })
                        {
                            <div class="tag-chip-list tag-chip-list--card" role="list" aria-label="Bookmark tags">
                                @foreach (var tag in item.Tags)
                                {
                                    <button type="button"
                                            class="tag-chip tag-chip--button"
                                            role="listitem"
                                            aria-label="Filter by tag @tag"
                                            @onclick="(() => SelectTagFilter(tag))">
                                        @tag
                                    </button>
                                }
                            </div>
                        }
                        <div class="bookmark-card__actions">
                            @* Edit action opens an in-page dialog to keep users in the board workflow. *@
                            <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="(() => OpenEditDialogAsync(item))">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -1px; margin-right: 3px;"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                                Edit
                            </button>
                            <button class="btn btn-sm btn-outline-danger" type="button" @onclick="(() => RequestDeleteBookmarkAsync(item))" aria-label="Delete bookmark @item.Title">Delete</button>
                        </div>
                    </article>
                }
            </div>

            @if (TotalPages > 1)
            {
                <nav class="pagination-bar" aria-label="Bookmark pages">
                    <button class="btn btn-outline-secondary btn-sm" type="button" disabled="@(_page <= 1 || IsLoading)" @onclick="(() => GoToPageAsync(_page - 1))">Previous</button>
                    <span aria-live="polite">Page @_page of @TotalPages</span>
                    <button class="btn btn-outline-secondary btn-sm" type="button" disabled="@(_page >= TotalPages || IsLoading)" @onclick="(() => GoToPageAsync(_page + 1))">Next</button>
                </nav>
            }
        }
    </section>
</div>

@if (IsEditDialogOpen)
{
    <div class="arc-modal-backdrop" @onclick="CloseEditDialog"></div>
    <section class="arc-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="edit-bookmark-title"
             tabindex="-1"
             @ref="_editDialogFocus"
             @onkeydown="HandleEditDialogKeyDownAsync">
        <header class="arc-modal__header">
            <div>
                <h2 id="edit-bookmark-title">Edit Bookmark</h2>
                <p class="page-subtitle">Update title, URL, summary, tags, or collections without leaving this page.</p>
            </div>
            <button class="arc-modal__close" type="button" @onclick="CloseEditDialog" aria-label="Close edit dialog" disabled="@IsSavingEdit">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </header>

        <EditForm Model="EditModel" OnValidSubmit="SaveEditAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label" for="edit-title">Title</label>
                <InputText id="edit-title" class="form-control" @bind-Value="EditModel.Title" @oninput="@(e => { EditModel.Title = e.Value?.ToString() ?? string.Empty; StateHasChanged(); })" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="edit-url">URL</label>
                <input id="edit-url"
                       class="form-control"
                       value="@EditModel.Url"
                       @oninput="HandleEditUrlInputAsync" />
                @if (IsEditMetadataLoading)
                {
                    <div class="form-text mt-1"><span class="spinner-inline"></span> Fetching page title and description...</div>
                }
                else if (!string.IsNullOrWhiteSpace(EditMetadataErrorText))
                {
                    <div class="form-text text-danger mt-1">@EditMetadataErrorText</div>
                }
                else if (EditMetadataSuggestion is not null)
                {
                    <section class="bookmark-metadata-suggestion mt-2" aria-label="URL metadata suggestion">
                        <p class="bookmark-metadata-suggestion__label">Suggested from URL</p>
                        <h3>@EditMetadataSuggestion.Title</h3>
                        @if (!string.IsNullOrWhiteSpace(EditMetadataSuggestion.Description))
                        {
                            <p>@EditMetadataSuggestion.Description</p>
                        }
                        <div class="bookmark-metadata-suggestion__actions">
                            <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="ApplyEditMetadataSuggestion">Use Suggestion</button>
                            <button class="btn btn-sm btn-primary" type="button" @onclick="ApplyEditMetadataSuggestionAndSaveAsync" disabled="@IsSavingEdit">
                                @if (IsSavingEdit) { <span class="spinner-inline"></span> }
                                Use and Save
                            </button>
                        </div>
                    </section>
                }
            </div>

            <div class="mb-3">
                <label class="form-label" for="edit-summary">Summary</label>
                <InputTextArea id="edit-summary" class="form-control" @bind-Value="EditModel.Summary" rows="3" @oninput="@(e => { EditModel.Summary = e.Value?.ToString(); StateHasChanged(); })" />
            </div>

            <div class="mb-3">
                <span class="form-label" id="edit-tags-label">Tags</span>
                <TagListInput InputId="edit-tags" Tags="_editTags" TagsChanged="HandleEditTagsChanged" />
            </div>

            <div class="mb-3">
                <span class="form-label" id="edit-collections-label">Collections</span>
                @if (AvailableCollections.Count == 0)
                {
                    <div class="form-text">No collections available yet.</div>
                }
                else
                {
                    <div class="collection-check-list" role="group" aria-labelledby="edit-collections-label">
                        @foreach (var collection in AvailableCollections)
                        {
                            var checkboxId = $"edit-collection-{collection.Id}";
                            <label class="d-flex align-items-center gap-2" for="@checkboxId" style="padding: 0.15rem 0; margin-left:@(UrlUtilities.CollectionDepth(AvailableCollections, collection.Id) * 0.7)rem;">
                                <input type="checkbox"
                                       id="@checkboxId"
                                       checked="@SelectedEditCollectionIds.Contains(collection.Id)"
                                       @onchange="(args => ToggleEditCollectionSelection(collection.Id, args.Value))" />
                                <span>@collection.Name</span>
                            </label>
                        }
                    </div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(EditErrorText))
            {
                <div class="alert alert-danger" role="alert">@EditErrorText</div>
            }

            <footer class="arc-modal__footer">
                <button class="btn btn-outline-secondary" type="button" @onclick="CloseEditDialog" disabled="@IsSavingEdit">Cancel</button>
                <button class="btn btn-primary" type="submit" disabled="@IsSavingEdit">
                    @if (IsSavingEdit) { <span class="spinner-inline"></span> }
                    Save Changes
                </button>
            </footer>
        </EditForm>
    </section>
}

<BookmarkCreateDialog IsOpen="IsCreateDialogOpen"
                      AvailableCollections="AvailableCollections"
                      OnCloseRequested="CloseCreateDialog"
                      OnCreated="HandleBookmarkCreatedAsync" />

<CollectionCreateDialog IsOpen="IsCreateCollectionDialogOpen"
                        AvailableCollections="AvailableCollections"
                        OnCloseRequested="CloseCreateCollectionDialog"
                        OnCreated="HandleCollectionCreatedAsync" />

<ConfirmDialog IsOpen="IsDeleteConfirmOpen"
               Title="Delete bookmark"
               Description="This removes the bookmark permanently."
               Message="@(_deleteCandidate is null ? null : $"Delete \"{_deleteCandidate.Title}\"?")"
               ConfirmLabel="Delete"
               IsBusy="IsDeleting"
               ErrorText="DeleteErrorText"
               OnConfirm="ConfirmDeleteBookmarkAsync"
               OnCancel="CancelDeleteBookmark" />

@code {
    private const string OtherVirtualCollectionKey = "other";
    private const int PageSize = 24;
    private const int SearchDebounceMilliseconds = 400;

    [Parameter]
    [SupplyParameterFromQuery(Name = "collectionId")]
    public Guid? SelectedCollectionId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "virtualCollection")]
    public string? VirtualCollection { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "tag")]
    public string? SelectedTag { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "sort")]
    public string? SortQuery { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "page")]
    public int? PageQuery { get; set; }

    private readonly List<BookmarkDto> _pageItems = [];
    private BookmarkStatsDto _stats = new(0, 0);
    private IReadOnlyList<CollectionTreeNodeDto> _collectionTree = [];
    private Dictionary<Guid, int> _collectionCounts = [];
    private int _totalCount;
    private int _page = 1;

    private bool IsLoading { get; set; }
    private string? ErrorText { get; set; }

    private bool IsCreateDialogOpen { get; set; }
    private bool IsCreateCollectionDialogOpen { get; set; }

    private bool IsDeleteConfirmOpen { get; set; }
    private bool IsDeleting { get; set; }
    private string? DeleteErrorText { get; set; }
    private BookmarkDto? _deleteCandidate;

    private bool IsEditDialogOpen { get; set; }
    private bool IsSavingEdit { get; set; }
    private string? EditErrorText { get; set; }
    private Guid? EditingBookmarkId { get; set; }
    private UpdateBookmarkRequest EditModel { get; set; } = new();
    private List<string> _editTags = [];
    private bool IsEditMetadataLoading { get; set; }
    private string? EditMetadataErrorText { get; set; }
    private UrlMetadataSuggestion? EditMetadataSuggestion { get; set; }
    private CancellationTokenSource? EditMetadataLookupCts { get; set; }
    private ElementReference _editDialogFocus;

    private IReadOnlyList<CollectionDto> AvailableCollections { get; set; } = [];
    private HashSet<Guid> SelectedEditCollectionIds { get; set; } = [];

    private CancellationTokenSource? _searchDebounceCts;
    private string _searchText = string.Empty;
    private string _appliedSearch = string.Empty;

    private string _sort = "updated";

    private string SearchText
    {
        get => _searchText;
        set
        {
            _searchText = value;
            _ = DebounceSearchReloadAsync();
        }
    }

    private string Sort
    {
        get => _sort;
        set => _sort = value;
    }

    private bool IsOtherCollectionSelected => string.Equals(VirtualCollection, OtherVirtualCollectionKey, StringComparison.OrdinalIgnoreCase);

    private int TotalPages => _totalCount == 0 ? 1 : (int)Math.Ceiling(_totalCount / (double)PageSize);

    protected override async Task OnInitializedAsync()
    {
        SharedStateService.OnBookmarksUpdated += HandleBookmarksUpdated;
        SharedStateService.OnCollectionsUpdated += HandleCollectionsUpdated;
        _sort = NormalizeSort(SortQuery);
        _page = Math.Max(1, PageQuery ?? 1);
        await LoadCollectionsAsync();
        await LoadAsync();
    }

    protected override void OnParametersSet()
    {
        // Query-string filters arrive through navigation; keep sort and page in sync.
        var normalizedSort = NormalizeSort(SortQuery);
        var normalizedPage = Math.Max(1, PageQuery ?? 1);

        if (!string.Equals(_sort, normalizedSort, StringComparison.Ordinal) || _page != normalizedPage)
        {
            _sort = normalizedSort;
            _page = normalizedPage;
            _ = InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            });
        }
    }

    private async void HandleBookmarksUpdated()
    {
        await InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private async void HandleCollectionsUpdated()
    {
        await InvokeAsync(async () =>
        {
            await LoadCollectionsAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        SharedStateService.OnBookmarksUpdated -= HandleBookmarksUpdated;
        SharedStateService.OnCollectionsUpdated -= HandleCollectionsUpdated;
        EditMetadataLookupCts?.Cancel();
        EditMetadataLookupCts?.Dispose();
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
    }

    private static string NormalizeSort(string? sort)
    {
        return sort?.Trim().ToLowerInvariant() switch
        {
            "created" => "created",
            "title" => "title",
            _ => "updated"
        };
    }

    private async Task LoadCollectionsAsync()
    {
        try
        {
            var collectionsTask = ApiClient.GetCollectionsAsync(CancellationToken.None);
            var treeTask = ApiClient.GetCollectionsTreeAsync(CancellationToken.None);
            var statsTask = ApiClient.GetBookmarkStatsAsync(CancellationToken.None);

            await Task.WhenAll(collectionsTask, treeTask, statsTask);

            AvailableCollections = collectionsTask.Result;
            _collectionTree = treeTask.Result;
            _collectionCounts = BuildCollectionCounts(_collectionTree);
            _stats = statsTask.Result;
        }
        catch (ApiClientException exception) when (SessionRedirect.ShouldRedirect(exception))
        {
            SessionRedirect.RedirectToLogin(NavigationManager);
        }
        catch (ApiClientException)
        {
            AvailableCollections = [];
            _collectionTree = [];
            _stats = new BookmarkStatsDto(0, 0);
        }
    }

    private int CountBookmarksInCollection(Guid collectionId)
    {
        // The tree payload carries every bookmark per collection, so counts stay exact without a second query.
        return _collectionCounts.TryGetValue(collectionId, out var count) ? count : 0;
    }

    private static Dictionary<Guid, int> BuildCollectionCounts(IReadOnlyList<CollectionTreeNodeDto> nodes)
    {
        var counts = new Dictionary<Guid, int>();

        void Collect(CollectionTreeNodeDto node)
        {
            counts[node.Id] = node.Bookmarks.Count;
            foreach (var child in node.Children)
            {
                Collect(child);
            }
        }

        foreach (var node in nodes)
        {
            Collect(node);
        }

        return counts;
    }

    private async Task DebounceSearchReloadAsync()
    {
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();

        var currentCts = new CancellationTokenSource();
        _searchDebounceCts = currentCts;

        try
        {
            await Task.Delay(SearchDebounceMilliseconds, currentCts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (currentCts.IsCancellationRequested)
        {
            return;
        }

        _appliedSearch = _searchText.Trim();
        _page = 1;
        await InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private async Task HandleSortChangedAsync(ChangeEventArgs args)
    {
        _sort = NormalizeSort(args.Value?.ToString());
        await NavigateAsync(page: 1);
    }

    private Task GoToPageAsync(int page)
    {
        return NavigateAsync(Math.Clamp(page, 1, TotalPages));
    }

    private Task NavigateAsync(int? page = null)
    {
        var query = new List<string>();

        if (SelectedCollectionId.HasValue)
        {
            query.Add($"collectionId={SelectedCollectionId.Value}");
        }

        if (IsOtherCollectionSelected)
        {
            query.Add($"virtualCollection={OtherVirtualCollectionKey}");
        }

        if (!string.IsNullOrWhiteSpace(SelectedTag))
        {
            query.Add($"tag={Uri.EscapeDataString(SelectedTag.Trim())}");
        }

        if (!string.Equals(_sort, "updated", StringComparison.Ordinal))
        {
            query.Add($"sort={_sort}");
        }

        var targetPage = page ?? _page;
        if (targetPage > 1)
        {
            query.Add($"page={targetPage}");
        }

        var suffix = query.Count > 0 ? $"?{string.Join("&", query)}" : string.Empty;
        NavigationManager.NavigateTo($"/bookmarks{suffix}");
        return Task.CompletedTask;
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorText = null;

        try
        {
            var request = new BookmarkListRequest
            {
                Search = string.IsNullOrWhiteSpace(_appliedSearch) ? null : _appliedSearch,
                CollectionId = IsOtherCollectionSelected ? null : SelectedCollectionId,
                UnassignedOnly = IsOtherCollectionSelected ? true : null,
                Tag = string.IsNullOrWhiteSpace(SelectedTag) ? null : SelectedTag.Trim(),
                Sort = _sort,
                Page = _page,
                PageSize = PageSize
            };

            var result = await ApiClient.GetBookmarksAsync(request, CancellationToken.None);
            _pageItems.Clear();
            _pageItems.AddRange(result.Items);
            _totalCount = result.TotalCount;
            _page = result.Page;
        }
        catch (ApiClientException exception) when (SessionRedirect.ShouldRedirect(exception))
        {
            SessionRedirect.RedirectToLogin(NavigationManager);
        }
        catch (ApiClientException exception)
        {
            ErrorText = exception.UserMessage;
        }
        catch (Exception)
        {
            ErrorText = "Could not load bookmarks from API.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void SelectCollection(Guid? collectionId)
    {
        var target = collectionId.HasValue
            ? $"/bookmarks?collectionId={collectionId.Value}"
            : "/bookmarks";

        NavigationManager.NavigateTo(target);
    }

    private void SelectOtherCollection()
    {
        NavigationManager.NavigateTo($"/bookmarks?virtualCollection={OtherVirtualCollectionKey}");
    }

    private void SelectTagFilter(string tag)
    {
        NavigationManager.NavigateTo($"/bookmarks?tag={Uri.EscapeDataString(tag)}");
    }

    private void ClearTagFilter()
    {
        NavigationManager.NavigateTo("/bookmarks");
    }

    private void OpenCreateDialog()
    {
        IsCreateDialogOpen = true;
    }

    private Task CloseCreateDialog()
    {
        IsCreateDialogOpen = false;
        return Task.CompletedTask;
    }

    private void OpenCreateCollectionDialog()
    {
        IsCreateCollectionDialogOpen = true;
    }

    private Task CloseCreateCollectionDialog()
    {
        IsCreateCollectionDialogOpen = false;
        return Task.CompletedTask;
    }

    private async Task HandleBookmarkCreatedAsync()
    {
        // New bookmark events update board counts and ordering immediately.
        await LoadAsync();
        await LoadCollectionsAsync();
        StateHasChanged();
    }

    private async Task HandleCollectionCreatedAsync()
    {
        // New collection events refresh sidebar tree and collection dropdowns.
        await LoadCollectionsAsync();
        StateHasChanged();
    }

    // --- Delete flow ---

    private Task RequestDeleteBookmarkAsync(BookmarkDto item)
    {
        _deleteCandidate = item;
        DeleteErrorText = null;
        IsDeleteConfirmOpen = true;
        return Task.CompletedTask;
    }

    private void CancelDeleteBookmark()
    {
        if (IsDeleting)
        {
            return;
        }

        IsDeleteConfirmOpen = false;
        _deleteCandidate = null;
        DeleteErrorText = null;
    }

    private async Task ConfirmDeleteBookmarkAsync()
    {
        if (_deleteCandidate is null)
        {
            IsDeleteConfirmOpen = false;
            return;
        }

        IsDeleting = true;
        DeleteErrorText = null;

        try
        {
            await ApiClient.DeleteBookmarkAsync(_deleteCandidate.Id, CancellationToken.None);
            IsDeleteConfirmOpen = false;
            _deleteCandidate = null;
            SharedStateService.NotifyBookmarksUpdated();
            await LoadAsync();
        }
        catch (ApiClientException exception) when (SessionRedirect.ShouldRedirect(exception))
        {
            IsDeleting = false;
            IsDeleteConfirmOpen = false;
            SessionRedirect.RedirectToLogin(NavigationManager);
        }
        catch (ApiClientException exception)
        {
            DeleteErrorText = exception.UserMessage;
        }
        catch (Exception)
        {
            DeleteErrorText = "Bookmark deletion failed.";
        }
        finally
        {
            IsDeleting = false;
        }
    }

    // --- Edit dialog flow ---

    private async Task OpenEditDialogAsync(BookmarkDto item)
    {
        // Clone selected values into a dedicated edit model so list rendering remains immutable.
        EditingBookmarkId = item.Id;
        EditModel = new UpdateBookmarkRequest
        {
            Title = item.Title,
            Url = item.Url,
            Summary = item.Summary,
            Tags = item.Tags ?? []
        };
        _editTags = [.. (item.Tags ?? [])];

        SelectedEditCollectionIds = item.CollectionIds.ToHashSet();

        EditErrorText = null;
        EditMetadataSuggestion = null;
        EditMetadataErrorText = null;
        IsEditMetadataLoading = false;
        IsEditDialogOpen = true;
        await QueueEditMetadataLookupAsync(EditModel.Url);
    }

    private void CloseEditDialog()
    {
        if (IsSavingEdit)
        {
            return;
        }

        IsEditDialogOpen = false;
        EditingBookmarkId = null;
        EditErrorText = null;
        EditMetadataSuggestion = null;
        EditMetadataErrorText = null;
        IsEditMetadataLoading = false;
        EditMetadataLookupCts?.Cancel();
        EditMetadataLookupCts?.Dispose();
        EditMetadataLookupCts = null;
        SelectedEditCollectionIds = [];
        _editTags = [];
    }

    private async Task HandleEditDialogKeyDownAsync(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.Ordinal))
        {
            CloseEditDialog();
            await Task.CompletedTask;
        }
    }

    private async Task HandleEditUrlInputAsync(ChangeEventArgs args)
    {
        EditModel.Url = args.Value?.ToString() ?? string.Empty;
        await QueueEditMetadataLookupAsync(EditModel.Url);
    }

    private async Task QueueEditMetadataLookupAsync(string? rawUrl)
    {
        EditMetadataLookupCts?.Cancel();
        EditMetadataLookupCts?.Dispose();

        var normalizedUrl = rawUrl?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(normalizedUrl))
        {
            IsEditMetadataLoading = false;
            EditMetadataSuggestion = null;
            EditMetadataErrorText = null;
            return;
        }

        // Debounced lookups keep editing smooth while metadata remains close to real-time.
        var currentCts = new CancellationTokenSource();
        EditMetadataLookupCts = currentCts;
        IsEditMetadataLoading = true;
        EditMetadataErrorText = null;

        try
        {
            await Task.Delay(450, currentCts.Token);
            var suggestion = await MetadataLookup.LookupAsync(normalizedUrl, currentCts.Token);
            EditMetadataSuggestion = suggestion;
        }
        catch (OperationCanceledException) when (currentCts.IsCancellationRequested)
        {
            // New URL input intentionally cancels stale metadata requests.
        }
        catch (Exception)
        {
            EditMetadataSuggestion = null;
            EditMetadataErrorText = "Could not fetch page metadata for this URL.";
        }
        finally
        {
            if (ReferenceEquals(EditMetadataLookupCts, currentCts))
            {
                IsEditMetadataLoading = false;
            }
        }
    }

    private void ApplyEditMetadataSuggestion()
    {
        if (EditMetadataSuggestion is null)
        {
            return;
        }

        // Applying metadata stays user-initiated so manual edits are never overwritten unexpectedly.
        EditModel.Title = EditMetadataSuggestion.Title;
        if (!string.IsNullOrWhiteSpace(EditMetadataSuggestion.Description))
        {
            EditModel.Summary = EditMetadataSuggestion.Description;
        }
    }

    private async Task ApplyEditMetadataSuggestionAndSaveAsync()
    {
        ApplyEditMetadataSuggestion();
        await SaveEditAsync();
    }

    private void HandleEditTagsChanged(IReadOnlyList<string> tags)
    {
        _editTags = [.. tags];
    }

    private async Task SaveEditAsync()
    {
        if (EditingBookmarkId is null)
        {
            EditErrorText = "No bookmark selected for edit.";
            return;
        }

        IsSavingEdit = true;
        EditErrorText = null;

        try
        {
            EditModel.Tags = _editTags;

            // Refreshing from API after update keeps sidebar counters and filtered ordering consistent.
            await ApiClient.UpdateBookmarkAsync(EditingBookmarkId.Value, EditModel, CancellationToken.None);
            await ApiClient.SyncBookmarkCollectionsAsync(EditingBookmarkId.Value, SelectedEditCollectionIds.ToList(), CancellationToken.None);

            CloseEditDialog();

            // Notify sidebar and board components so tree/list views stay consistent.
            SharedStateService.NotifyBookmarksUpdated();

            await LoadAsync();
            await LoadCollectionsAsync();
            StateHasChanged();
        }
        catch (ApiClientException exception) when (SessionRedirect.ShouldRedirect(exception))
        {
            IsSavingEdit = false;
            IsEditDialogOpen = false;
            SessionRedirect.RedirectToLogin(NavigationManager);
        }
        catch (ApiClientException exception)
        {
            EditErrorText = exception.UserMessage;
        }
        catch (Exception)
        {
            EditErrorText = "Bookmark update failed.";
        }
        finally
        {
            IsSavingEdit = false;
        }
    }

    private void ToggleEditCollectionSelection(Guid collectionId, object? rawValue)
    {
        var isChecked = rawValue as bool? == true;
        if (isChecked)
        {
            SelectedEditCollectionIds.Add(collectionId);
            return;
        }

        SelectedEditCollectionIds.Remove(collectionId);
    }
}
