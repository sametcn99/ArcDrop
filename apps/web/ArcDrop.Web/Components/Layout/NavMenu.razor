@using ArcDrop.Web.Components.UI

@inject IArcDropApiClient ApiClient
@inject ISharedStateService SharedStateService
@inject NavigationManager NavigationManager
@implements IDisposable

<div class="top-row navbar-brand-shell">
    <div class="container-fluid px-3 d-flex align-items-center gap-2">
        <span class="navbar-brand-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
            </svg>
        </span>
        <a class="navbar-brand" href="/bookmarks">ArcDrop</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" aria-label="Toggle navigation menu" />

<div class="nav-scrollable">
    <nav class="nav-shell" aria-label="Application sections">
        <div class="nav-section px-3">
            <p class="nav-section-label">Menu</p>
            <ul class="nav-section-links">
                <li><a href="/home" class="nav-section-link">Home</a></li>
                <li><a href="/bookmarks" class="nav-section-link">Bookmarks</a></li>
                <li><a href="/ai/organize" class="nav-section-link">AI Organize</a></li>
                <li><a href="/ai/providers" class="nav-section-link">AI Providers</a></li>
                <li><a href="/ai/operations" class="nav-section-link">AI History</a></li>
                <li><a href="/settings" class="nav-section-link">Settings</a></li>
                <li><a href="/auth/profile" class="nav-section-link">Profile</a></li>
            </ul>
        </div>

        <div class="bookmark-header px-3">
            <p class="nav-section-label">Collections</p>
            <button class="bookmark-refresh" type="button" @onclick="LoadCollectionsSidebarAsync" disabled="@IsBusy">Refresh</button>
        </div>

        @if (IsBusy)
        {
            <div class="px-3 bookmark-state"><span class="spinner-inline"></span> Loading collections...</div>
        }
        else if (!string.IsNullOrWhiteSpace(ErrorText))
        {
            <div class="px-3 bookmark-state bookmark-state--error">@ErrorText</div>
        }
        else if (CollectionTree.Count == 0 && Stats.UnassignedCount == 0)
        {
            <div class="px-3 bookmark-state">No collections yet.</div>
        }
        else
        {
            <CascadingValue Value="NodeActions" IsFixed="false">
                <div class="bookmark-list collection-section__list px-2">
                    @if (Stats.UnassignedCount > 0)
                    {
                        <CollectionTreeNode @key="OtherVirtualCollectionId"
                                            Node="BuildOtherCollectionNode()"
                                            Depth="0"
                                            ActiveCollectionId="ActiveCollectionId"
                                            HrefOverride="@GetOtherCollectionHref()"
                                            ForceActive="@IsOtherCollectionActive"
                                            IsVirtualNode="true" />
                    }

                    @foreach (var node in CollectionTree)
                    {
                        <CollectionTreeNode @key="node.Id"
                                            Node="node"
                                            Depth="0"
                                            ActiveCollectionId="ActiveCollectionId" />
                    }
                </div>
            </CascadingValue>
        }
    </nav>
</div>

<CollectionEditDialog IsOpen="IsEditCollectionOpen"
                      Collection="_editCollectionCandidate"
                      AvailableCollections="FlatCollections"
                      OnCloseRequested="CloseEditCollectionDialog"
                      OnUpdated="HandleCollectionUpdatedAsync" />

<ConfirmDialog IsOpen="IsDeleteCollectionConfirmOpen"
               Title="Delete collection"
               Description="Collections must be empty of child collections before deletion."
               Message="@(_deleteCollectionCandidate is null ? null : $"Delete collection \"{_deleteCollectionCandidate.Name}\"? Bookmarks stay intact and become unassigned.")"
               ConfirmLabel="Delete"
               IsBusy="IsDeletingCollection"
               ErrorText="DeleteCollectionErrorText"
               OnConfirm="ConfirmDeleteCollectionAsync"
               OnCancel="CancelDeleteCollection" />

@code {
    private const string OtherVirtualCollectionKey = "other";
    private static readonly Guid OtherVirtualCollectionId = Guid.Empty;

    private readonly List<CollectionTreeNodeDto> CollectionTree = [];
    private readonly List<CollectionDto> FlatCollections = [];
    private BookmarkStatsDto Stats { get; set; } = new(0, 0);
    private bool IsBusy { get; set; }
    private string? ErrorText { get; set; }
    private Guid? ActiveCollectionId { get; set; }
    private bool IsOtherCollectionActive { get; set; }
    private CollectionNodeActions? NodeActions { get; set; }

    private bool IsEditCollectionOpen { get; set; }
    private CollectionDto? _editCollectionCandidate;

    private bool IsDeleteCollectionConfirmOpen { get; set; }
    private bool IsDeletingCollection { get; set; }
    private string? DeleteCollectionErrorText { get; set; }
    private CollectionTreeNodeDto? _deleteCollectionCandidate;

    protected override async Task OnInitializedAsync()
    {
        SharedStateService.OnBookmarksUpdated += HandleBookmarksUpdated;
        SharedStateService.OnCollectionsUpdated += HandleCollectionsUpdated;
        NavigationManager.LocationChanged += HandleLocationChanged;
        NodeActions = new CollectionNodeActions(RequestEditCollection, RequestDeleteCollection);
        ActiveCollectionId = ParseActiveCollectionId();
        IsOtherCollectionActive = ParseOtherCollectionIsActive();
        await LoadCollectionsSidebarAsync();
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        ActiveCollectionId = ParseActiveCollectionId();
        IsOtherCollectionActive = ParseOtherCollectionIsActive();
        _ = InvokeAsync(StateHasChanged);
    }

    private async void HandleBookmarksUpdated()
    {
        // Refresh both data sources so the virtual Other collection stays in sync with the tree.
        await InvokeAsync(async () =>
        {
            await LoadCollectionsSidebarAsync();
            StateHasChanged();
        });
    }

    private async void HandleCollectionsUpdated()
    {
        await InvokeAsync(async () =>
        {
            await LoadCollectionsSidebarAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        SharedStateService.OnBookmarksUpdated -= HandleBookmarksUpdated;
        SharedStateService.OnCollectionsUpdated -= HandleCollectionsUpdated;
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }

    private async Task LoadCollectionsSidebarAsync()
    {
        IsBusy = true;
        ErrorText = null;

        try
        {
            // Stats provide total/unassigned counts while the tree provides per-collection structure.
            var treeTask = ApiClient.GetCollectionsTreeAsync(CancellationToken.None);
            var flatTask = ApiClient.GetCollectionsAsync(CancellationToken.None);
            var statsTask = ApiClient.GetBookmarkStatsAsync(CancellationToken.None);

            await Task.WhenAll(treeTask, flatTask, statsTask);

            CollectionTree.Clear();
            CollectionTree.AddRange(treeTask.Result);
            FlatCollections.Clear();
            FlatCollections.AddRange(flatTask.Result);
            Stats = statsTask.Result;
        }
        catch (ApiClientException exception) when (SessionRedirect.ShouldRedirect(exception))
        {
            SessionRedirect.RedirectToLogin(NavigationManager);
        }
        catch (ApiClientException exception)
        {
            ErrorText = exception.UserMessage;
        }
        catch (Exception)
        {
            ErrorText = "Could not load collections.";
        }
        finally
        {
            IsBusy = false;
        }
    }

    private CollectionTreeNodeDto BuildOtherCollectionNode()
    {
        // Represent uncategorized bookmarks as a virtual collection so the sidebar uses one rendering path.
        return new CollectionTreeNodeDto(
            OtherVirtualCollectionId,
            "Other",
            null,
            null,
            DateTimeOffset.MinValue,
            DateTimeOffset.MinValue,
            [],
            []);
    }

    private static string GetOtherCollectionHref()
    {
        return "/bookmarks?virtualCollection=other";
    }

    private void RequestEditCollection(CollectionTreeNodeDto node)
    {
        _editCollectionCandidate = FlatCollections.FirstOrDefault(collection => collection.Id == node.Id);
        if (_editCollectionCandidate is not null)
        {
            IsEditCollectionOpen = true;
        }
    }

    private Task CloseEditCollectionDialog()
    {
        IsEditCollectionOpen = false;
        _editCollectionCandidate = null;
        return Task.CompletedTask;
    }

    private async Task HandleCollectionUpdatedAsync()
    {
        await LoadCollectionsSidebarAsync();
        StateHasChanged();
    }

    private void RequestDeleteCollection(CollectionTreeNodeDto node)
    {
        _deleteCollectionCandidate = node;
        DeleteCollectionErrorText = null;
        IsDeleteCollectionConfirmOpen = true;
    }

    private void CancelDeleteCollection()
    {
        if (IsDeletingCollection)
        {
            return;
        }

        IsDeleteCollectionConfirmOpen = false;
        _deleteCollectionCandidate = null;
        DeleteCollectionErrorText = null;
    }

    private async Task ConfirmDeleteCollectionAsync()
    {
        if (_deleteCollectionCandidate is null)
        {
            IsDeleteCollectionConfirmOpen = false;
            return;
        }

        IsDeletingCollection = true;
        DeleteCollectionErrorText = null;

        try
        {
            await ApiClient.DeleteCollectionAsync(_deleteCollectionCandidate.Id, CancellationToken.None);
            IsDeleteCollectionConfirmOpen = false;
            _deleteCollectionCandidate = null;
            SharedStateService.NotifyCollectionsUpdated();
            SharedStateService.NotifyBookmarksUpdated();
        }
        catch (ApiClientException exception) when (SessionRedirect.ShouldRedirect(exception))
        {
            IsDeletingCollection = false;
            IsDeleteCollectionConfirmOpen = false;
            SessionRedirect.RedirectToLogin(NavigationManager);
        }
        catch (ApiClientException exception)
        {
            DeleteCollectionErrorText = exception.UserMessage;
        }
        catch (Exception)
        {
            DeleteCollectionErrorText = "Collection deletion failed.";
        }
        finally
        {
            IsDeletingCollection = false;
        }
    }

    private Guid? ParseActiveCollectionId()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (!query.TryGetValue("collectionId", out var rawId))
        {
            return null;
        }

        return Guid.TryParse(rawId.ToString(), out var parsedId) ? parsedId : null;
    }

    private bool ParseOtherCollectionIsActive()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        return query.TryGetValue("virtualCollection", out var rawVirtualCollection)
            && string.Equals(rawVirtualCollection.ToString(), OtherVirtualCollectionKey, StringComparison.OrdinalIgnoreCase);
    }
}
