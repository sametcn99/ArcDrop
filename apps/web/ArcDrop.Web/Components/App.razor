<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="ArcDrop - self-host-first bookmarking workspace with AI-assisted organization." />
    <meta name="theme-color" content="#0a7c5b" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["lib/fonts/fonts.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["ArcDrop.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="icon" type="image/svg+xml" href="logo.svg" />
    <link rel="manifest" href="site.webmanifest" />
    <HeadOutlet />
</head>

<body>
    <script>
        // Align Bootstrap's built-in dark widgets with the OS color scheme preference.
        (function () {
            var preferred = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
            document.documentElement.setAttribute("data-bs-theme", preferred ? "dark" : "light");
        })();
    </script>
    <CascadingAuthenticationState>
        <Routes />
    </CascadingAuthenticationState>
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
        // File download helper for Blazor interop. Converts base64 data to a Blob
        // and triggers a browser download without round-tripping through SignalR.
        window.arcDropDownloadFile = function (base64Data, fileName, contentType) {
            var raw = atob(base64Data);
            var byteArray = new Uint8Array(raw.length);
            for (var i = 0; i < raw.length; i++) {
                byteArray[i] = raw.charCodeAt(i);
            }
            var blob = new Blob([byteArray], { type: contentType });
            var url = URL.createObjectURL(blob);
            var anchor = document.createElement("a");
            anchor.href = url;
            anchor.download = fileName;
            document.body.appendChild(anchor);
            anchor.click();
            document.body.removeChild(anchor);
            URL.revokeObjectURL(url);
        };
    </script>
</body>

</html>
