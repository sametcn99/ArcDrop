<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:ArcDrop.Avalonia.ViewModels.Pages"
             xmlns:views="using:ArcDrop.Avalonia.Views"
             xmlns:pagesViews="using:ArcDrop.Avalonia.Views.Pages"
             x:Class="ArcDrop.Avalonia.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <DataTemplate DataType="{x:Type pages:DashboardViewModel}">
            <pagesViews:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:BookmarkListViewModel}">
            <pagesViews:BookmarkListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:BookmarkEditViewModel}">
            <pagesViews:BookmarkEditView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:SettingsViewModel}">
            <pagesViews:SettingsView />
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
