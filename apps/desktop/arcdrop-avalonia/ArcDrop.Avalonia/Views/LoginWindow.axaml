<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ArcDrop.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="ArcDrop.Avalonia.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Title="ArcDrop - Sign in"
        Width="420" Height="440"
        WindowStartupLocation="CenterScreen"
        CanResize="False">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="32" RowSpacing="12">
        <TextBlock Text="ArcDrop"
                   FontSize="30"
                   FontWeight="Bold" />

        <TextBlock Grid.Row="1"
                   Text="Sign in with your administrator account to sync bookmarks."
                   TextWrapping="Wrap"
                   Opacity="0.7" />

        <StackPanel Grid.Row="2" Spacing="6">
            <TextBlock Text="Username" />
            <TextBox Text="{Binding Username}"
                     PlaceholderText="Username" />
        </StackPanel>

        <StackPanel Grid.Row="3" Spacing="6">
            <TextBlock Text="Password" />
            <TextBox Text="{Binding Password}"
                     PlaceholderText="Password"
                     PasswordChar="*" />
        </StackPanel>

        <TextBlock Grid.Row="4"
                   Text="{Binding ErrorMessage}"
                   IsVisible="{Binding HasError}"
                   TextWrapping="Wrap"
                   Foreground="#e0705f" />

        <Button Grid.Row="5"
                Content="Sign In"
                Command="{Binding LoginCommand}"
                HorizontalAlignment="Stretch" />
    </Grid>
</Window>
