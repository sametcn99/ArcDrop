<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:ArcDrop.Maui.ViewModels"
             x:Class="ArcDrop.Maui.Views.LoginPage"
             x:DataType="viewModels:LoginViewModel"
             Title="Sign in to ArcDrop">

    <Grid Padding="32"
          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
          RowSpacing="14"
          VerticalOptions="Center"
          MaximumWidthRequest="420">

        <Label Text="ArcDrop"
               FontSize="30"
               FontAttributes="Bold"
               SemanticProperties.HeadingLevel="Level1" />

        <Label Grid.Row="1"
               Text="Sign in with your administrator account to sync bookmarks."
               FontSize="14"
               TextColor="{StaticResource Gray400}" />

        <VerticalStackLayout Grid.Row="2" Spacing="6">
            <Label Text="Username" FontSize="13" />
            <Entry Text="{Binding Username}"
                   Placeholder="Username"
                   AutoCorrect="False"
                   AutoCapitalize="None"
                   SemanticProperties.Hint="Administrator username" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="3" Spacing="6">
            <Label Text="Password" FontSize="13" />
            <Entry Text="{Binding Password}"
                   Placeholder="Password"
                   IsPassword="True"
                   SemanticProperties.Hint="Administrator password" />
        </VerticalStackLayout>

        <Label Grid.Row="4"
               Text="{Binding ErrorMessage}"
               IsVisible="{Binding HasError}"
               TextColor="{StaticResource Red500}"
               FontSize="13"
               LineBreakMode="WordWrap" />

        <Button Grid.Row="5"
                Text="Sign In"
                Command="{Binding LoginCommand}"
                SemanticProperties.Hint="Sign in to ArcDrop" />
    </Grid>
</ContentPage>
