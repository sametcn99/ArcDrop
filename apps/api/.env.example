# ArcDrop API local development overrides — copy to apps/api/.env
# (bun loads it automatically when running from that directory).

ARCDROP__DATABASE__URL=postgres://arcdrop:arcdrop@localhost:5432/arcdrop
ARCDROP__JWT__SECRET=dev-only-secret-change-me-0123456789abcdef
ARCDROP__PORT=3000
ARCDROP__CORS__ORIGINS=http://localhost:5173
ARCDROP__DATA_DIR=./.data
ARCDROP__METRICS__ENABLED=false
ARCDROP__METADATA__ENABLED=true
# NEVER enable in production — test/dev affordance for stub servers on loopback.
# Redirect hops are validated strictly regardless.
# ARCDROP__METADATA__ALLOW_PRIVATE=true
# Per-PAT request budget per minute (M7). Default 300 — above the global
# per-IP budget so it only bites when one token is used from many addresses.
# ARCDROP__MCP__PAT_REQUESTS_PER_MINUTE=300
# Per-user fixed-window limits on expensive routes (M9).
# ARCDROP__RATE_LIMIT__IMPORT_PER_MINUTE=30
# ARCDROP__RATE_LIMIT__REINDEX_PER_MINUTE=30
# ARCDROP__RATE_LIMIT__MCP_TOOLS_PER_MINUTE=300
# M8 import caps (bytes). Single files default to 25 MiB; ZIP archives to
# 300 MB (they unpack to many files at once). Exceeding the cap is a 413.
# ARCDROP__PORTABILITY__IMPORT_MAX_BYTES=26214400
# ARCDROP__PORTABILITY__IMPORT_ZIP_MAX_BYTES=314572800
ARCDROP__LOG__LEVEL=debug
