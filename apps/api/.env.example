# ArcDrop API local development overrides — copy to apps/api/.env
# (bun loads it automatically when running from that directory).

ARCDROP__DATABASE__URL=postgres://arcdrop:arcdrop@localhost:5432/arcdrop
ARCDROP__JWT__SECRET=dev-only-secret-change-me-0123456789abcdef
ARCDROP__PORT=3000
ARCDROP__CORS__ORIGINS=http://localhost:5173
ARCDROP__DATA_DIR=./.data
ARCDROP__METRICS__ENABLED=false
ARCDROP__LOG__LEVEL=debug
